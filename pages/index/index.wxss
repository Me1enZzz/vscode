.hero{display:flex;align-items:center;height:128rpx;gap:22rpx;position:relative}.logo{width:84rpx;height:84rpx;border-radius:18rpx;background:linear-gradient(135deg,#63a5ff,#2f7be5);color:#fff;font-size:42rpx;display:flex;align-items:center;justify-content:center;box-shadow:0 12rpx 28rpx rgba(47,123,229,.28)}.app-title{font-size:37rpx;color:#2f7be5;font-weight:800}.app-sub{font-size:22rpx;color:#7d8795;margin-top:8rpx}.tiles{display:flex;gap:30rpx;margin-top:34rpx}.tile{flex:1;height:150rpx;border-radius:14rpx;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:42rpx;box-shadow:0 12rpx 28rpx rgba(31,41,55,.13)}.tile text{white-space:pre-line;text-align:center;font-size:24rpx;margin-top:8rpx;font-weight:700}.red{background:linear-gradient(135deg,#ff816e,#e95047)}.green{background:linear-gradient(135deg,#65c982,#31a85f)}.blue{background:linear-gradient(135deg,#68a8ff,#327fe5)}
