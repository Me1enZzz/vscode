page { background:#f7f9fc; color:#1f2937; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",Arial,sans-serif; }
.container { min-height:100vh; padding: 24rpx 28rpx 140rpx; box-sizing:border-box; }
.nav { height:88rpx; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:34rpx; position:relative; }
.back { position:absolute; left:0; color:#8c97a6; font-size:46rpx; font-weight:300; }
.capsule { position:absolute; right:0; display:flex; gap:18rpx; background:rgba(255,255,255,.88); border-radius:32rpx; padding:10rpx 18rpx; box-shadow:0 8rpx 24rpx rgba(31,41,55,.06); }
.search { display:flex; align-items:center; gap:14rpx; height:64rpx; padding:0 24rpx; border-radius:32rpx; background:#fff; color:#a0a8b5; font-size:25rpx; box-shadow: inset 0 0 0 1rpx rgba(226,232,240,.8); }
.card { background:#fff; border-radius:18rpx; box-shadow:0 12rpx 35rpx rgba(31,41,55,.07); overflow:hidden; }
.row { display:flex; align-items:center; padding:24rpx; border-bottom:1rpx solid #edf1f5; }
.row:last-child { border-bottom:0; }
.icon { width:48rpx; height:48rpx; border-radius:12rpx; display:flex; align-items:center; justify-content:center; color:#fff; margin-right:20rpx; font-weight:700; }
.git { background:linear-gradient(135deg,#ff704f,#e94335); }
.npm { background:linear-gradient(135deg,#ff5b46,#d6332e); font-size:20rpx; }
.linux { background:linear-gradient(135deg,#1f2937,#111827); }
.shell { background:linear-gradient(135deg,#6bd091,#24a661); }
.title { font-size:29rpx; font-weight:700; color:#2b3442; }
.sub { font-size:23rpx; color:#7d8795; margin-top:5rpx; }
.tag { margin-left:auto; background:#eef3f8; color:#8090a0; border-radius:14rpx; padding:5rpx 13rpx; font-size:20rpx; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin:28rpx 0 14rpx; font-weight:700; }
.more { color:#9aa4b2; font-size:22rpx; font-weight:500; }
.tabbar { position:fixed; left:0; right:0; bottom:0; height:112rpx; background:#fff; display:flex; justify-content:space-around; box-shadow:0 -8rpx 30rpx rgba(31,41,55,.07); }
.tab { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#9aa4b2; font-size:21rpx; }
.tab.active { color:#2f7be5; font-weight:700; }
.tab .i { font-size:34rpx; line-height:1; margin-bottom:6rpx; }
